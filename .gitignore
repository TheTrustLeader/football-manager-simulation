# Dependencies. package-lock.json is deliberately not committed, which is why
# this repo uses `npm install` and not `npm ci`.
node_modules/
package-lock.json

# Build output (tsconfig outDir).
dist/

# The evidence file a local `npm run evidence` writes. The dated GATE-1A and
# REVIEW-002 files in evidence/ ARE committed records and stay tracked - only
# this generated one is ignored.
evidence/match-lab-evidence.json

# Python bytecode from the verify-queue robot script.
.github/scripts/__pycache__/

# Console captures the CI steps write with `tee`. The shell creates these the
# moment the step starts, so they make the tree dirty BEFORE the evidence
# provenance guard reads it - which is the "a build step is writing an untracked
# file" case that the guard's own comment in match-lab-ci.yml predicts. They are
# transient logs, not records: the committed record is evidence/ and the run's
# uploaded artifact.
calibration-evidence.txt
simulation-summary.txt
